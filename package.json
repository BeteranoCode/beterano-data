{
  "name": "beterano-data",
  "version": "1.0.0",
  "description": "Repositorio central de datos técnicos para proyectos de Beterano",
  "main": "scripts/sync_biblioteca.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "import:parts": "ts-node scripts/import-parts-from-xlsx.ts",
    "import:parts:tsv": "ts-node scripts/import-parts-from-tsv.ts",
    "import:parts:translations": "ts-node scripts/import-parts-translations.ts",
    "import:vehicles": "ts-node scripts/import-vehicles.ts",
    "translations:fix": "ts-node scripts/fix-translations-from-tsv.ts",
    "translations:check": "ts-node scripts/translations-check.ts",
    "translations:missing": "ts-node scripts/report-missing-translations.ts",
    "cleanup:loading": "ts-node scripts/cleanup-loading-placeholders.ts",
    "migrate:part-systems": "ts-node scripts/migrate-part-systems-canonical.ts",
    "import:part-tree": "ts-node scripts/import-part-tree.ts",
    "fix:translations": "ts-node scripts/fix-translations.ts --source xlsx --file datasets/parts/biblioteca_piezas.xlsx",
    "sync": "node scripts/sync_biblioteca.js",
    "seed:lab": "ts-node scripts/seed-lab-postgres.ts",
    "seed:motors": "ts-node scripts/seed-motors-firestore.ts",
    "dict:export": "ts-node scripts/export-parts-dictionary.ts",
    "dict:import": "ts-node scripts/import-parts-dictionary.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "Beterano",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.6.0",
    "google-spreadsheet": "^4.1.5",
    "iso-3166-2": "^1.0.0",
    "pg": "^8.16.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "country-region-data": "^4.1.0",
    "prisma": "^6.19.0",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "world-countries": "^5.1.0"
  }
}
