generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VehicleMake {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models    VehicleModel[]
}

model VehicleModel {
  id        String   @id @default(cuid())
  makeId    String
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  make      VehicleMake @relation(fields: [makeId], references: [id])
  variants  VehicleVariant[]
  media     MediaAsset[]

  @@index([makeId])
}

model VehicleVariant {
  id        String   @id @default(cuid())
  modelId   String
  key       String   @unique
  name      String
  yearFrom  Int?
  yearTo    Int?
  engine    String?
  fuel      String?
  powerKw   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model     VehicleModel @relation(fields: [modelId], references: [id])

  @@index([modelId])
}

model TaxonomyNode {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  parentId  String?
  kind      TaxonomyKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    TaxonomyNode? @relation("TaxonomyTree", fields: [parentId], references: [id])
  children  TaxonomyNode[] @relation("TaxonomyTree")
  translations TaxonomyNodeTranslation[]

  services  ServiceOperation[]
  parts     PartCategory[]
  media     MediaAsset[]
  catalogItems WorkCatalogItem[]

  @@index([parentId])
  @@index([kind])
}

model ServiceOperation {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  skillKey          String?
  taxonomyNodeId    String?
  estimatedMinutes  Int?
  source            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  taxonomyNode      TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id])
  translations      ServiceOperationTranslation[]

  @@index([taxonomyNodeId])
  @@index([skillKey])
}

model PartCategory {
  id             String   @id @default(cuid())
  key            String
  name           String
  groupId        String?
  systemId       String?
  taxonomyNodeId String?
  source         String?
  imageKey       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group          PartGroup? @relation(fields: [groupId], references: [id])
  system         PartSystem? @relation(fields: [systemId], references: [id])
  taxonomyNode   TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id])
  elements       PartElement[]
  translations   PartCategoryTranslation[]

  @@index([taxonomyNodeId])
  @@index([groupId])
  @@index([systemId])
  @@unique([groupId, key])
}

model MediaAsset {
  id             String   @id @default(cuid())
  key            String   @unique
  type           MediaType
  url            String
  path           String?
  taxonomyNodeId String?
  vehicleModelId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taxonomyNode   TaxonomyNode? @relation(fields: [taxonomyNodeId], references: [id])
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  @@index([taxonomyNodeId])
  @@index([vehicleModelId])
}

model WorkCatalogItem {
  id         String   @id @default(cuid())
  code       Int
  key        String   @unique
  name       String
  kind       CatalogItemKind
  categoryId String
  aliases    Json?
  keywords   Json?
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   TaxonomyNode @relation(fields: [categoryId], references: [id])
  translations WorkCatalogItemTranslation[]

  @@index([code])
  @@index([categoryId, kind])

  @@map("CatalogItem")
}

model WorkCatalogItemTranslation {
  id          String   @id @default(cuid())
  itemId      String
  locale      Locale
  name        String
  description String?
  aliases     Json?

  item        WorkCatalogItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, locale])
  @@index([locale])

  @@map("CatalogItemTranslation")
}

model TaxonomyNodeTranslation {
  id             String   @id @default(cuid())
  taxonomyNodeId String
  locale         Locale
  name           String

  taxonomyNode   TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id])

  @@unique([taxonomyNodeId, locale])
  @@index([locale])
}

model ServiceOperationTranslation {
  id           String   @id @default(cuid())
  operationId  String
  locale       Locale
  name         String
  aliases      Json?
  keywords     Json?
  confidenceHint String?

  operation    ServiceOperation @relation(fields: [operationId], references: [id])

  @@unique([operationId, locale])
  @@index([locale])
}

model PartSystem {
  id        String   @id @default(cuid())
  key       String   @unique
  imageKey  String?
  imageUrl  String?
  createdAt DateTime @default(now())

  groups    PartGroup[]
  categories PartCategory[]
  elements  PartElement[]
  translations PartSystemTranslation[]
}

model PartGroup {
  id        String   @id @default(cuid())
  key       String
  systemId  String
  imageKey  String?
  imageUrl  String?
  createdAt DateTime @default(now())

  system    PartSystem @relation(fields: [systemId], references: [id])
  categories PartCategory[]
  elements  PartElement[]
  translations PartGroupTranslation[]

  @@index([systemId])
  @@unique([systemId, key])
}

model PartElement {
  id         String   @id @default(cuid())
  key        String   @unique
  categoryId String
  systemId   String?
  groupId    String?
  legacyId   String?
  imageKey   String?
  imageUrl   String?
  createdAt  DateTime @default(now())

  category   PartCategory @relation(fields: [categoryId], references: [id])
  system     PartSystem? @relation(fields: [systemId], references: [id])
  group      PartGroup? @relation(fields: [groupId], references: [id])
  translations PartElementTranslation[]

  @@index([categoryId])
  @@index([systemId])
  @@index([groupId])
}

model PartSystemTranslation {
  id             String   @id @default(cuid())
  systemId       String
  locale         Locale
  name           String
  aliasesJson    Json?
  keywordsJson   Json?
  confidenceHint String?

  system         PartSystem @relation(fields: [systemId], references: [id])

  @@unique([systemId, locale])
  @@index([locale])
}

model PartGroupTranslation {
  id             String   @id @default(cuid())
  groupId        String
  locale         Locale
  name           String
  aliasesJson    Json?
  keywordsJson   Json?
  confidenceHint String?

  group          PartGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, locale])
  @@index([locale])
}

model PartCategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         Locale
  name           String
  aliasesJson    Json?
  keywordsJson   Json?
  confidenceHint String?

  category       PartCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, locale])
  @@index([locale])
}

model PartElementTranslation {
  id             String   @id @default(cuid())
  elementId      String
  locale         Locale
  name           String
  aliasesJson    Json?
  keywordsJson   Json?
  confidenceHint String?

  element        PartElement @relation(fields: [elementId], references: [id])

  @@unique([elementId, locale])
  @@index([locale])
}

enum TaxonomyKind {
  VEHICLE_SYSTEM
  SERVICE
  PARTS
  OTHER
  CATALOG
}

enum MediaType {
  IMG
  GLB
}

enum CatalogItemKind {
  LABOR
  PART
  CONSUMABLE
  FEE
}

enum Locale {
  ar
  de
  en
  es
  fr
  hr
  it
  ja
  nl
  pl
  tr
  zh
}
